{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "baseUrl": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": [
      "es2022",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@hr-systems/libs": [
        "libs/src/index.ts"
      ],
      "@hr-systems/libs/*": [
        "libs/src/lib/*"
      ]
    },
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "node_modules",
    "tmp",
    "dist"
  ]
}